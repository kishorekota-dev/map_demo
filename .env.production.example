# Complete this file outside version control. Values are dotenv data, not shell code.
# Use distinct random secrets; the preflight rejects blanks and sample values.
NODE_ENV=production
AUTH_PROVIDER=oidc
DEPLOYMENT_TENANT_ID=
CONTROL_PLANE_ENABLED=true
CONTROL_PLANE_ENVIRONMENT=production
CHAT_PERSISTENCE_ENABLED=true
WORKFLOW_DURABLE_EXECUTION=true
CHECKPOINT_ENABLED=true
CHECKPOINT_BACKEND=postgres
CHECKPOINT_SCHEMA_AUTO_MIGRATE=false
HANDOFF_STORAGE=postgres
FULFILLMENT_WORKER_ENABLED=true
INTERNAL_SERVICE_AUTH_REQUIRED=true
JWT_SECRET=
SERVICING_SERVICE_TOKEN=
SESSION_SECRET=
AUDIT_ACTOR_HASH_KEY=
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Bundled production Compose uses private hosts postgres/redis and user poc_user.
# Enter complete URLs with the matching URL-safe passwords above.
# Databases: poc_banking for control plane/operations, ai_orchestrator for workflow,
# and poc_chat for handoff. Example structure: postgresql://poc_user:PASSWORD@postgres:5432/poc_banking
CONTROL_PLANE_DATABASE_URL=
OPERATIONS_DATABASE_URL=
WORKFLOW_DATABASE_URL=
HANDOFF_DATABASE_URL=
REDIS_URL=
BANKING_RUN_MIGRATIONS=false
BANKING_SEED_DEMO_DATA=false
CONTROL_PLANE_MANAGE_SCHEMA=false
OPERATIONS_MANAGE_SCHEMA=false
WORKFLOW_SCHEMA_AUTO_MIGRATE=false
HANDOFF_SCHEMA_AUTO_MIGRATE=false
DATABASE_MANAGE_SCHEMA=false
# Apply reviewed migrations before starting services; production runtime does not own DDL.
FRONTEND_URL=
ALLOWED_ORIGINS=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_JWKS_URI=
OIDC_REDIRECT_URI=
OIDC_CLIENT_SECRET_REF=
OIDC_CLIENT_SECRET=
# Absolute host paths. No credentials belong in the public runtime JSON.
FRONTEND_RUNTIME_CONFIG_FILE=
LLM_PROVIDERS_HOST_FILE=
CONNECTORS_CONFIG_PATH=
CONNECTOR_ALLOWED_HOSTS=
CONNECTOR_PRIVATE_HOSTS=
CASE_CONNECTOR_ID=
# An empty provider registry supports deterministic servicing without model calls.
LLM_OPENAI_API_KEY=
LLM_GEMINI_API_KEY=
LLM_OLLAMA_BASE_URL=
MOCK_DIALOGFLOW=true
MOCK_EXTERNAL_AI_SERVICES=true
NLU_REQUEST_TIMEOUT_MS=5000
AGENT_RESPONSE_TIMEOUT=400000
SERVICING_REQUEST_TIMEOUT_MS=410000
