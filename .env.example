# Enterprise Conversational Platform - Environment Configuration
# Copy this file to .env.development for local development or use it as the basis for an enterprise profile.

# ===========================================
# General
# ===========================================
NODE_ENV=development
LOG_LEVEL=debug

# ===========================================
# Product Metadata
# ===========================================
ORG_SLUG=demo-enterprise
ORG_NAME="Demo Enterprise"
PRODUCT_DISPLAY_NAME="Enterprise Conversational Platform"
PRODUCT_TAGLINE="Configurable AI assistants for secure enterprise workflows"
AUTH_PROVIDER=jwt
DEFAULT_DEPLOYMENT_MODE=docker-compose
FRONTEND_RUNTIME_CONFIG_PATH=services/frontend/public/runtime-config.json

# ===========================================
# Database
# ===========================================
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_USER=poc_user
DB_PASSWORD=

# ===========================================
# Redis (for sessions/caching)
# ===========================================
REDIS_URL=redis://localhost:6379

# ===========================================
# Security
# ===========================================
JWT_SECRET=
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=10
# Banking sign-in lockout: consecutive wrong passwords, then lock length.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15

# ===========================================
# Service URLs (for inter-service communication)
# ===========================================
FRONTEND_URL=http://localhost:3000
API_GATEWAY_URL=http://localhost:3001
CHAT_BACKEND_URL=http://localhost:3006
BANKING_SERVICE_URL=http://localhost:3005
AUTH_API_BASE_URL=http://localhost:3005/api/v1
NLP_SERVICE_URL=http://localhost:3003
NLU_SERVICE_URL=http://localhost:3003
MCP_SERVICE_URL=http://localhost:3004
AI_ORCHESTRATOR_URL=http://localhost:3007
AGENT_UI_URL=http://localhost:8081

# ===========================================
# AI Services (Optional)
# ===========================================
# Remote response generation is off unless both values below are configured.
OPENAI_ENABLED=false
OPENAI_API_KEY=

# Remote extraction requires SLM_ENABLED=true plus a usable SLM/OpenAI key.
# A non-empty local SLM_BASE_URL is also an explicit opt-in and needs no key.
SLM_ENABLED=false
SLM_BASE_URL=
SLM_API_KEY=

# DialogFlow - Required for NLU Service
DIALOGFLOW_PROJECT_ID=your-dialogflow-project-id
GOOGLE_APPLICATION_CREDENTIALS=

# ===========================================
# CORS
# ===========================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# ===========================================
# Rate Limiting
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Servicing control plane: deployment-scoped configuration and runtime policy
DEPLOYMENT_TENANT_ID=default-enterprise
CONTROL_PLANE_ENABLED=true
CONTROL_PLANE_URL=http://localhost:3001/api/control-plane
# Development defaults to services/api-gateway/data/control-plane.json.
# Production: set CONTROL_PLANE_DATABASE_URL to PostgreSQL (supports multiple gateway replicas).
# Alternative: an absolute persistent CONTROL_PLANE_DATA_FILE and one writer.
CONTROL_PLANE_SINGLE_WRITER=true

# Dedicated enterprise operations (PostgreSQL required; no in-memory fallback).
# OPERATIONS_DATABASE_URL defaults to CONTROL_PLANE_DATABASE_URL, then DATABASE_URL.
# OPERATIONS_DATABASE_URL=postgresql://poc_user:poc_password@localhost:5432/poc_banking
OPERATIONS_URL=http://localhost:3001/api/operations
FULFILLMENT_WORKER_ENABLED=true
SERVICING_SERVICE_TOKEN=
WORKFLOW_DURABLE_EXECUTION=true
CHECKPOINT_ENABLED=true
CHECKPOINT_BACKEND=postgres
CHECKPOINT_SCHEMA_AUTO_MIGRATE=true
HANDOFF_STORAGE=postgres
# Set false only after installing the documented schema migrations.
WORKFLOW_SCHEMA_AUTO_MIGRATE=true
HANDOFF_SCHEMA_AUTO_MIGRATE=true
CONTROL_PLANE_MANAGE_SCHEMA=true
OPERATIONS_MANAGE_SCHEMA=true
# WORKFLOW_DATABASE_URL and HANDOFF_DATABASE_URL default to each service DB_* settings.
CONTROL_PLANE_ENVIRONMENT=development
# Optional provider-neutral recognition endpoint; lexical policy works without it.
RECOGNITION_PROVIDER_URL=
RECOGNITION_PROVIDER_TOKEN=
# Explicit allowlist for external connector hosts (comma-separated, no wildcards).
CONNECTOR_ALLOWED_HOSTS=
CONNECTOR_PRIVATE_HOSTS=
CONNECTOR_ALLOW_LOCAL=false
CONNECTOR_SECRET_ROOT=
CASE_CONNECTOR_ID=
SLA_ESCALATION_QUEUE=supervisor
OPERATIONS_RETENTION_DAYS=90
# Identity requires all endpoints, exact issuer and a registered callback URI.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_AUTHORIZATION_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_JWKS_URI=
OIDC_REDIRECT_URI=
OIDC_CLIENT_SECRET_REF=
OIDC_ALLOW_LOCAL=false
FRONTEND_URL=http://localhost:3000
# Secrets referenced by connectors: env:CONNECTOR_SECRET_<NAME> or file:<relative path>.
# Mount an RSA private key for signed evidence exports; archive exports externally.
AUDIT_SIGNING_KEY_FILE=
AUDIT_ACTOR_HASH_KEY=

# Application LLM plugins. These settings belong to the AI orchestrator only.
# Relative registry paths resolve from services/ai-orchestrator for all launch modes.
LLM_PROVIDERS_FILE=config/llm-providers.example.json
# Replace mac-studio.local with the actual Studio hostname or LAN address.
LLM_OLLAMA_BASE_URL=http://mac-studio.local:11434
# Cloud adapters remain disabled until explicitly configured and selected.
LLM_OPENAI_API_KEY=
LLM_GEMINI_API_KEY=
# Full chat turn: up to three model stages at 120 seconds each, plus service overhead.
# Tune these together with runtime-config.json chatRequestTimeoutMs (default 420000).
AGENT_RESPONSE_TIMEOUT=400000
SERVICING_REQUEST_TIMEOUT_MS=410000
# Vertex Gemini uses Google Application Default Credentials unless the registry
# explicitly references a short-lived access token. Mount credentials in Docker.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/credentials.json

CHAT_PERSISTENCE_ENABLED=true

NLU_REQUEST_TIMEOUT_MS=5000
