{
  "name": "poc-agent-ui",
  "version": "1.0.0",
  "description": "POC Agent Dashboard UI for banking chat system - handles escalated customer conversations",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "build": "npm run check",
    "build:dev": "npm run check",
    "check": "node --check server.js && node --check services/authClient.js && node --check services/chatClientService.js && node --check services/socketManager.js && node --check public/js/dashboard.js && node --check public/js/chat.js",
    "test": "jest --runInBand",
    "test:watch": "jest --watch",
    "lint": "eslint server.js routes services public/js",
    "lint:fix": "eslint server.js routes services public/js --fix",
    "clean": "rm -rf dist/ node_modules/.cache/",
    "validate": "npm run lint && npm run test"
  },
  "keywords": [
    "banking",
    "chat",
    "agent",
    "dashboard",
    "microservice",
    "websocket",
    "real-time"
  ],
  "author": "POC Banking Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.15.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.10.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "redis": "^4.6.8",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.7.2",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "eslint": "^8.45.0",
    "jest": "^29.6.2",
    "nodemon": "^3.0.1",
    "supertest": "^6.3.3"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kishorekota-dev/map_demo.git"
  },
  "bugs": {
    "url": "https://github.com/kishorekota-dev/map_demo/issues"
  },
  "homepage": "https://github.com/kishorekota-dev/map_demo#readme"
}
