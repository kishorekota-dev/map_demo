# AI Orchestrator Service Configuration
# Environment: Development

# ===== SERVER CONFIGURATION =====
NODE_ENV=development
PORT=3007
HOST=localhost
LOG_LEVEL=debug

# ===== DATABASE CONFIGURATION =====
# PostgreSQL for session management
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_orchestrator
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=20
DB_POOL_MIN=5
DB_POOL_IDLE=10000

# ===== REDIS CONFIGURATION =====
# Redis for caching and temporary state
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# ===== OPENAI CONFIGURATION =====
# Tool-backed banking responses are deterministic and never use the response
# model. Enable remote generation only for no-tool intents when desired.
OPENAI_ENABLED=false
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0
OPENAI_TOP_P=0
OPENAI_SEED=42
OPENAI_MAX_TOKENS=2000

# ===== SLM (STRUCTURED EXTRACTOR) CONFIGURATION =====
# Remote extraction is opt-in. A local SLM_BASE_URL also enables extraction
# without requiring an API key.
SLM_ENABLED=false
SLM_BASE_URL=
SLM_API_KEY=
SLM_TEMPERATURE=0
SLM_TOP_P=0
SLM_SEED=42
SLM_JSON_MODE=true

# ===== MCP SERVICE CONFIGURATION =====
# Transport pinning for deterministic tool execution: http | protocol | auto
MCP_TRANSPORT=http
MCP_SERVICE_URL=http://localhost:3004
MCP_SERVICE_TIMEOUT=30000
MCP_RETRY_ATTEMPTS=3
MCP_RETRY_DELAY=1000

# ===== MICROSERVICE ENDPOINTS =====
NLU_SERVICE_URL=http://localhost:3003
BANKING_SERVICE_URL=http://localhost:3005
CHAT_BACKEND_URL=http://localhost:3006

# ===== SECURITY CONFIGURATION =====
JWT_SECRET=ai-orchestrator-jwt-secret-change-in-production
JWT_EXPIRY=24h
API_KEY=dev-api-key-change-in-production

# ===== CORS CONFIGURATION =====
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3006,http://localhost:8081

# ===== WORKFLOW CONFIGURATION =====
MAX_WORKFLOW_STEPS=50
WORKFLOW_TIMEOUT=300000
HUMAN_FEEDBACK_TIMEOUT=300000
MAX_RETRIES=3

# ===== SESSION CONFIGURATION =====
SESSION_TTL=1800000
SESSION_CLEANUP_INTERVAL=300000
MAX_SESSIONS_PER_USER=5

# ===== LANGGRAPH CONFIGURATION =====
GRAPH_RECURSION_LIMIT=50
GRAPH_DEBUG_MODE=true
CHECKPOINT_ENABLED=true

# ===== PROMPT CONFIGURATION =====
DEFAULT_SYSTEM_PROMPT=You are a helpful banking assistant.
MAX_PROMPT_LENGTH=4000

# ===== POLICY ENGINE CONFIGURATION =====
POLICY_ENGINE_ENABLED=true
POLICY_BLOCK_PROMPT_INJECTION=true
POLICY_REDACT_SENSITIVE_DATA=true
POLICY_MAX_INPUT_LENGTH=2000
POLICY_MAX_RESPONSE_LENGTH=2000
POLICY_TRANSFER_CONFIRMATION_AMOUNT=1000
POLICY_TRANSFER_HARD_BLOCK_AMOUNT=25000

# ===== RATE LIMITING =====
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ===== MONITORING =====
ENABLE_METRICS=true
METRICS_INTERVAL=60000
