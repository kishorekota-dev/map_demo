# AI Orchestrator Service - Environment Variables

# Server Configuration
NODE_ENV=development
PORT=3007
LOG_LEVEL=debug

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_orchestrator_dev
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# OpenAI Configuration
# Tool-backed responses always use deterministic tool formatting. Remote
# generation is optional for no-tool intents and requires this explicit flag.
OPENAI_ENABLED=false
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4
OPENAI_TEMPERATURE=0
OPENAI_TOP_P=0
OPENAI_SEED=42
OPENAI_MAX_TOKENS=1000

# Remote extraction requires SLM_ENABLED=true plus a usable key. Alternatively,
# set a local OpenAI-compatible SLM_BASE_URL; the local URL needs no API key.
SLM_ENABLED=false
SLM_BASE_URL=
SLM_API_KEY=
SLM_TEMPERATURE=0
SLM_TOP_P=0
SLM_SEED=42
SLM_JSON_MODE=true

# MCP Service Configuration
# HTTP-based MCP (legacy/fallback)
MCP_SERVICE_URL=http://localhost:3005/api/tools
MCP_TIMEOUT=30000
MCP_MAX_RETRIES=3

# Transport pinning for deterministic tool execution: http | protocol | auto
MCP_TRANSPORT=http

# True MCP Protocol (SSE-based) — only used when MCP_TRANSPORT != http
MCP_SSE_URL=http://localhost:3005/mcp/sse
MCP_PREFER_PROTOCOL=true
MCP_ENABLE_FALLBACK=true

# Session Configuration
SESSION_TTL=86400
SESSION_CLEANUP_INTERVAL=3600

# Workflow Configuration
WORKFLOW_MAX_STEPS=20
WORKFLOW_TIMEOUT=60000
WORKFLOW_CHECKPOINT_ENABLED=true

# Policy Engine Configuration
POLICY_ENGINE_ENABLED=true
POLICY_BLOCK_PROMPT_INJECTION=true
POLICY_REDACT_SENSITIVE_DATA=true
POLICY_MAX_INPUT_LENGTH=2000
POLICY_MAX_RESPONSE_LENGTH=2000
POLICY_TRANSFER_CONFIRMATION_AMOUNT=1000
POLICY_TRANSFER_HARD_BLOCK_AMOUNT=25000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8081
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Feature Flags
FEATURE_HUMAN_IN_LOOP=true
FEATURE_TOOL_EXECUTION=true
FEATURE_SESSION_PERSISTENCE=true
FEATURE_CHECKPOINT_RECOVERY=true
